# /etc/sudoers.d/surgic -- generated by `surgic jamf sudoers`; deploy via Jamf.
# Grants ONLY the exact privileged commands surgic issues. Regenerate on config change.
Cmnd_Alias SURGIC_CMDS = \
    /sbin/pfctl -s info, \
    /sbin/pfctl -s rules, \
    /sbin/pfctl -s Interfaces -v, \
    /sbin/pfctl -n -f /etc/pf.anchors/airgap.rules, \
    /sbin/pfctl -f /etc/pf.anchors/airgap.rules, \
    /sbin/pfctl -E, \
    /sbin/pfctl -f /etc/pf.conf, \
    /sbin/pfctl ^-X [0-9]+$, \
    /sbin/ifconfig pflog0 create, \
    /usr/sbin/tcpdump -U -n -i any -w /Volumes/RAMDisk/audit/egress_audit.pcap not host 10.0.0.5 and not host 127.0.0.1 and not host \:\:1, \
    /usr/sbin/tcpdump -U -n -i pflog0 -w /Volumes/RAMDisk/audit/pflog_blocked.pcap, \
    /bin/kill ^-INT [0-9]+$, \
    /usr/bin/mdutil -i off /Volumes/RAMDisk, \
    /usr/sbin/lsof -nP -iTCP -sTCP\:LISTEN -iUDP, \
    /usr/bin/profiles show -type configuration, \
    /usr/bin/tee /etc/pf.anchors/airgap.rules
Defaults:svc_surgic !requiretty, !lecture, env_reset
svc_surgic ALL = (root) NOPASSWD: SURGIC_CMDS
