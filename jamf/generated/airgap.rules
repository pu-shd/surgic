# /etc/pf.anchors/airgap.rules  (generated by surgic; loaded as the MAIN ruleset so
# no com.apple/* anchors with their own pass rules remain in effect)
set block-policy drop
set skip on lo0

# Default deny all inbound and outbound, logged to pflog0 for evidence
block drop in log all
block drop out log all

# Allow SMB strictly to the approved share server (stateful: replies permitted)
pass out quick inet proto tcp from any to 10.0.0.5 port 445 flags S/SA keep state
